# E5 — claves de proveedores (§8.1). Copiar a .env y rellenar con valores reales.
# .env está en .gitignore. NUNCA commitear valores reales. Si se filtra: rotar.

# --- Anthropic (agentes H1/H2/H3) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# ID versionado y estable, NO alias (§1.1).
CLAUDE_MODEL=claude-sonnet-5

# --- Groq (guardrail de sensibilidad) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Verificar que sigue activo en console.groq.com y anotar el ID exacto (§1.3).
GROQ_MODEL=openai/gpt-oss-20b

# --- Supabase (única fuente de estado) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- WhatsApp vía Twilio (CANAL ACTIVO) ---
# Consola de Twilio → Account Info. En el sandbox, el "from" es el número
# compartido de Twilio; en producción, tu número de WhatsApp aprobado.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx
# Número emisor en E.164 (sin 'whatsapp:'; el adaptador lo agrega). Sandbox: +14155238886.
TWILIO_WHATSAPP_FROM=+14155238886
# Validar X-Twilio-Signature en el webhook. En dev con URLs de túnel cambiantes
# déjalo en false; en producción ponlo en true y fija PUBLIC_BASE_URL.
TWILIO_VALIDATE_SIGNATURE=false
# URL pública base (sin barra final) — debe coincidir EXACTO con la Callback URL
# configurada en Twilio. Solo se usa si TWILIO_VALIDATE_SIGNATURE=true.
PUBLIC_BASE_URL=https://tu-dominio.ngrok-free.dev

# --- WhatsApp Cloud API (Meta Developers) — EJEMPLO, no se usa ---
# Se conserva como referencia para empresas con acceso directo a la Cloud API.
# La app NO lee estas variables mientras el canal activo sea Twilio; déjalas
# vacías o coméntalas. Para volver a Meta: ver README (sección "Volver a Meta").
# WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_VERIFY_TOKEN=un-token-secreto-que-invento
# WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxx
# GRAPH_API_VERSION=v21.0

# --- Guardrail (calibrado en fase 8: recall 'sensible' 100% con umbral 0.7) ---
GUARDRAIL_UMBRAL_CONFIANZA=0.7
# Timeout por intento. Groq responde ~334ms normal, pero el tier gratuito se
# ralentiza bajo ráfagas; 1200ms da holgura sin bloquear el webhook.
GUARDRAIL_TIMEOUT_MS=1200
# Reintentos ante fallo transitorio de Groq (429/timeout/red) antes de escalar
# a ticket. Evita que un throttling momentáneo mande todo a fail-closed.
GUARDRAIL_REINTENTOS=1
GUARDRAIL_BACKOFF_MS=300

# --- Agente Claude (fase 4) ---
CLAUDE_MAX_TOKENS=1024

# --- Panel humano (fase 6) — auth básica, cambiar en producción ---
PANEL_USER=admin
PANEL_PASSWORD=cambiar-esto

# --- Scheduler proactivo (fase 7) ---
SCHEDULER_HABILITADO=true
SCHEDULER_INTERVALO_MIN=30
